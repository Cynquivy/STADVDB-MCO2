NODE_ID=1 # 1, 2 or 3: which VM this instance runs on
PORT=80 # 80 on the VMs; use e.g. 3000 on a laptop
DB_NAME=mco2
DB_USER=ddb
DB_PASSWORD= # Provided to you in messenger.

# On the cloud (internal network):
NODE1_HOST=10.20.200.244
NODE1_PORT=3306
NODE2_HOST=10.20.200.245
NODE2_PORT=3306
NODE3_HOST=10.20.200.246
NODE3_PORT=3306

# On a laptop, replace the six lines above with the public portforwards:
# NODE1_HOST=103.231.240.136
# NODE1_PORT=61243
# NODE2_HOST=103.231.240.136
# NODE2_PORT=61244
# NODE3_HOST=103.231.240.136
# NODE3_PORT=61245

# The app on each VM (the status page checks they are running)
NODE1_APP_URL=http://10.20.200.244
NODE2_APP_URL=http://10.20.200.245
NODE3_APP_URL=http://10.20.200.246

# On a laptop, use the public app URLs instead:
# NODE1_APP_URL=http://103.231.240.136:10244
# NODE2_APP_URL=http://103.231.240.136:10245
# NODE3_APP_URL=http://103.231.240.136:10246

ISOLATION_LEVEL="REPEATABLE READ"  # default, final choice TO BE DECIDED
DB_CONNECT_TIMEOUT_MS=2000         # fast failure detection
LOCK_WAIT_TIMEOUT_S=10             # SET SESSION innodb_lock_wait_timeout
HEALTH_INTERVAL_MS=2000            # how often each app checks all three nodes
RECOVERY_INTERVAL_MS=3000          # how often the recovery worker runs
PENDING_GRACE_MS=5000              # a PENDING entry with no last_error, younger than this, is an in-flight write
ADMIN_TOKEN=                       # any long random string, the SAME on all 3 VMs; turns on Kill / Restore (stop/start MySQL)
